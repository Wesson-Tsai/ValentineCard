<PageTitle>Letter</PageTitle>

<div class="page-background">

    <!-- 信封外框 (加入淡入動畫) -->
    <div class="letter-wrapper fade-in">

        <!-- 斜躺在右上角的貓貓 -->
        <img src="images/PrettyCat.png" class="lying-cat" alt="Lying Cat" />

        <!-- 信件文字內容 -->
        <div class="letter-content">
            <div class="greeting">小蔡說：</div>

            <div class="body-text">
                小寶寶！！！很開心可以跟你在一起，也想要一直跟你在一起渡過每個美好的時光。身為工程師的女朋友可能沒辦法收到很浪漫的驚喜，但希望這個專屬的小卡片能為你帶來快樂！我花很多時間做的喔～~ 愛你！
            </div>

            <div class="signature">愛你的小蔡</div>
        </div>

        <!-- 返回主畫面的按鈕 (沿用之前的按鈕樣式) -->
        <div class="action-area">
            <button class="finish-btn" @onclick="ReturnToMain">返回主畫面</button>
        </div>

    </div>
</div>

@code {
    // 讓父元件 (Home.razor) 可以接收返回訊號
    [Parameter]
    public EventCallback OnLetterSelected { get; set; }

    private async Task ReturnToMain()
    {
        await OnLetterSelected.InvokeAsync();
    }
}